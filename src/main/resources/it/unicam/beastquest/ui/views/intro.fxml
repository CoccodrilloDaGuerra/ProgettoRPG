<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafax"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.beastquest.ui.controllers.IntroController">


    <padding>
        <Insets top="40.0" bottom="40.0" left="60.0" right="60.0"/>
    </padding>

    <Label fx:id="titleLabel" text=" "  style="-fx-font-size: 26px; -fx-font-weight: bold"/>

    <ScrollPane fitToWidth="true" prefHeight="250.0">
        <Label fx:id="storyLabel" text=" " wrapText="true" style="-fx-font-size: 15px; "/>

    </ScrollPane>

    <Button text="Continua" onAction="#handleContinua" prefWidth="150.0"/>



</VBox>