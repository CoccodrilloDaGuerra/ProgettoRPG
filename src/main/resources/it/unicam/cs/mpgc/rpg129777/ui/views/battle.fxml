<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.cs.mpgc.rpg129777.ui.controllers.BattleController">

    <padding >
          <Insets top="30.0" bottom="30.0" left="30.0" right="30.0"/>

    </padding>


    <Label fx:id="playerNameLabel" text="Player" styleClass="player-name-label"/>
    <ProgressBar fx:id="playerHpBar" prefWidth="250.0"/>
    <Label fx:id="playerHpLabel" text="HP: 0/0"/>


    <Label text="VS" style="-fx-font-size: 20px"/>

    <Label fx:id="enemyNameLabel" text="Enemy"  styleClass="-enemy-name-label"/>
     <ProgressBar fx:id="enemyHpBar" prefWidth="250.0"/>
    <Label fx:id="enemyHpLabel" text="HP: 0/0"/>

    <Label fx:id="messageLabel" text=" " wrapText="true" styleClass="message-label"/>

<HBox alignment="CENTER" spacing="15.0">

    <Button fx:id="attackButton" text="Attacca" onAction="#handleAttack" styleClass="attack-button" prefWidth="120.0"/>
    <Button fx:id="useItemButton" text="Usa Oggetto" onAction="#handleUseItem" styleClass="item-button" prefWidth="120.0"/>
    <Button fx:id="fleeButton" text="Fuggi" onAction="#handleFlee" styleClass="flee-button" prefWidth="120.0"/>
     <Button fx:id="returnToHubButton" text="Torna all'Hub" onAction="#handleReturnToHub"
             prefWidth="150.0" visible="false" managed="false"/>
</HBox>

</VBox>
